{
  "required": true,
  "minVersion": "0.8",
  "package": "dev.o7moon.openboatutils.mixin",
  "compatibilityLevel": "JAVA_17",
  "refmap": "OpenBoatUtils-refmap.json",
  "mixins": [
    "ServerPlayNetworkHandlerMixin",
    "PotentSulfurBlockEntityMixin"
  ],
  "client": [
    "BoatMixin",
    "BoatAccessor",
    "ClientWorldMixin",
    "EntityMixin",
    "BoatRendererMixin",
    "HoneyBlockMixin",
    "CameraMixin",
    "MinecraftMixin",
    "BoatRenderStateMixin"
    //? >=1.21.5 {
    /*,"PositionInterpolatorAccessor"
    *///?}
  ],
  "injectors": {
    "defaultRequire": 1,
    "maxShiftBy": 2
  }
}